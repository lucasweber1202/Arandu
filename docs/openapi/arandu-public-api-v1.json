{
  "openapi": "3.1.0",
  "info": {
    "title": "Arandu Public API",
    "version": "v1",
    "description": "API máquina-a-máquina do Arandu Financial Procurement. Autorização = credencial AND organização AND entidade AND escopo AND objeto. Ver docs/FINANCIAL_PUBLIC_API.md."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token de conta de serviço (arnd_<ambiente>_<43 base62>)"
      }
    },
    "responses": {
      "Error": {
        "description": "Erro",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "correlation_id"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "correlation_id": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Page": {
        "type": "object",
        "required": [
          "data",
          "page"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "page": {
            "type": "object",
            "required": [
              "limit",
              "has_more",
              "next_cursor"
            ],
            "properties": {
              "limit": {
                "type": "integer"
              },
              "has_more": {
                "type": "boolean"
              },
              "next_cursor": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "Item": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "RfqCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product",
          "title",
          "demand",
          "owner_id"
        ],
        "properties": {
          "product": {
            "enum": [
              "credit",
              "acquiring"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4000
          },
          "demand": {
            "type": "object",
            "description": "Campos do catálogo do produto (lib/finance/products.mjs); campo desconhecido é recusado"
          },
          "response_deadline": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "legal_entity_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "owner_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "WebhookCreate": {
        "type": "object",
        "required": [
          "url",
          "events"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "events": {
            "type": "array",
            "items": {
              "enum": [
                "rfq.created",
                "rfq.status_changed",
                "proposal.submitted",
                "decision.recorded",
                "approval.required",
                "approval.completed",
                "contract.created",
                "contract.renewal_due"
              ]
            }
          },
          "legal_entity_ids": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "description": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    }
  },
  "paths": {
    "/me": {
      "get": {
        "summary": "Contexto da credencial",
        "security": [
          {
            "bearer": []
          }
        ],
        "x-arandu-scope": null,
        "parameters": [
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{8,80}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
