# Arandu — variáveis de ambiente

# Contato público
ARANDU_WHATSAPP_NUMBER=
ARANDU_CONTACT_EMAIL=
ARANDU_SITE_URL=
ARANDU_WRITE_TEST_URL=
ARANDU_BRAND_READY=false
ARANDU_COMMERCIAL_READY=false
ARANDU_PILOT_ENABLED=false
ARANDU_PILOT_APPROVED=false
ARANDU_PILOT_ACCESS_CODE=
ARANDU_PILOT_SECRET=
ARANDU_DISTRIBUTED_RATE_LIMIT=false
ARANDU_PRIVACY_CONTACT_EMAIL=
ARANDU_ERROR_MONITORING_READY=false
ARANDU_BACKUP_VERIFIED_AT=

# Supabase usado pela função consolidada api/[...path].js
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional para aplicar migrations por CLI/psql. Nunca exponha no navegador.
SUPABASE_DB_URL=

# Administração usa Supabase Auth, papel imutável em app_metadata e MFA TOTP.
# Não existe segredo administrativo compartilhado.

# Futuro envio de e-mail
RESEND_API_KEY=

# Futuro analytics
PUBLIC_ANALYTICS_ID=
