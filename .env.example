# Arandu — variáveis de ambiente

# Configuração pública não secreta
# Obrigatória em produção para habilitar métricas consentidas. Use a versão real publicada.
# Se ausente em dev/preview, analytics permanece deliberadamente desativado.
ARANDU_CONSENT_VERSION=

# Contato público
ARANDU_WHATSAPP_NUMBER=
ARANDU_CONTACT_EMAIL=
ARANDU_SITE_URL=
ARANDU_WRITE_TEST_URL=
ARANDU_BRAND_READY=false
# Somente para previews controlados. O build recusa este modo em VERCEL_ENV=production.
ARANDU_PRESENTATION_MODE=false
ARANDU_COMMERCIAL_READY=false
ARANDU_COMMERCIAL_POLICY_VERSION=
ARANDU_COMMERCIAL_CURRENCY=
ARANDU_PLATFORM_FEE_RATE=
ARANDU_RESERVATION_HOURS=
ARANDU_PAYMENT_POLICY_REFERENCE=
ARANDU_SHIPPING_POLICY_REFERENCE=
ARANDU_PACKAGING_POLICY_REFERENCE=
ARANDU_INSURANCE_POLICY_REFERENCE=
ARANDU_CANCELLATION_POLICY_REFERENCE=
ARANDU_RETURN_POLICY_REFERENCE=
ARANDU_DAMAGE_POLICY_REFERENCE=
ARANDU_CERTIFICATE_POLICY_REFERENCE=
ARANDU_FISCAL_MODEL_REFERENCE=
ARANDU_COMMERCIAL_OWNER=
ARANDU_COMMERCIAL_APPROVER=
ARANDU_COMMERCIAL_APPROVED_AT=
ARANDU_COMMERCIAL_APPROVAL_REFERENCE=
ARANDU_PILOT_ENABLED=false
ARANDU_PILOT_APPROVED=false
ARANDU_PILOT_ACCESS_CODE=
ARANDU_PILOT_SECRET=
ARANDU_DISTRIBUTED_RATE_LIMIT=false
ARANDU_PRIVACY_CONTACT_EMAIL=
ARANDU_ERROR_MONITORING_READY=false
ARANDU_ERROR_MONITORING_ENDPOINT=
ARANDU_ERROR_MONITORING_TOKEN=
ARANDU_BACKUP_VERIFIED_AT=

# E-mail transacional. Mantenha disabled até configurar um provedor real.
ARANDU_EMAIL_PROVIDER=disabled
ARANDU_EMAIL_FROM=
ARANDU_EMAIL_REPLY_TO=
ARANDU_TRANSACTIONAL_EMAIL_READY=false
ARANDU_EMAIL_DISPATCH_ENABLED=false
ARANDU_EMAIL_CRON_SECRET=
ARANDU_RECIPIENT_HMAC_SECRET=
ARANDU_RECIPIENT_HMAC_VERSION=v1
RESEND_API_KEY=

# Timeouts opcionais do runtime servidor, em milissegundos (1.000 a 30.000).
ARANDU_EXTERNAL_REQUEST_TIMEOUT_MS=8000
ARANDU_AUTH_TIMEOUT_MS=8000
ARANDU_SUPABASE_TIMEOUT_MS=8000

# Bucket opcional de mídia. O valor não é segredo; credenciais nunca vão ao browser.
ARANDU_STORAGE_BUCKET=arandu-media

# Supabase usado pela função consolidada api/[...path].js
# Obrigatório em produção. SERVICE_ROLE_KEY é segredo exclusivamente servidor.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional para aplicar migrations por CLI/psql. Nunca exponha no navegador.
SUPABASE_DB_URL=

# Execução real de staging: use somente em GitHub Environment protegido.
ARANDU_STAGING_DATABASE_URL=
ARANDU_STAGING_SITE_URL=
ARANDU_STAGING_PROJECT_REF=
ARANDU_PRODUCTION_PROJECT_REF=
ARANDU_STAGING_BACKUP_REFERENCE=
ARANDU_STAGING_RESTORE_REFERENCE=

# Validação de uma restauração já feita em banco descartável.
ARANDU_RESTORE_DATABASE_URL=

# Administração usa Supabase Auth, papel imutável em app_metadata e MFA TOTP.
# Não existe segredo administrativo compartilhado.

# Futuro analytics
PUBLIC_ANALYTICS_ID=
