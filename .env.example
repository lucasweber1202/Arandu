# Arandu — variáveis de ambiente

# Ambiente: demo (demonstração canônica, branch main, Supabase DEMO próprio),
# pilot (arandu-pilot, branch pilot) ou production (arandu, branch main).
# Vazio em desenvolvimento e previews. Com demo/pilot/production, o build roda
# finance:env:check e as rotas legadas de arte respondem 404.
ARANDU_ENV=

# Seed/reset da demonstração (npm run demo:seed / demo:reset): NUNCA no Vercel e
# NUNCA em produção. Só na máquina de quem semeia o banco DEMO; ver docs/demo/RESET.md.
# ARANDU_DEMO_CONFIRM=<ref do projeto Supabase DEMO, ou "local">
# ARANDU_DEMO_APP_URL=<URL https da aplicação com ARANDU_ENV=demo>
# ARANDU_DEMO_PASSWORD=<senha forte das personas fictícias; não versionar>

# Sandbox legado (sem banco, motor no navegador). Substituído pela demonstração
# canônica (ARANDU_ENV=demo); mantido até o projeto arandu-demo migrar.
# Só no projeto Vercel arandu-demo: ARANDU_DEPLOYMENT_KIND=demo faz o vercel-build
# gerar a demonstração (build:demo), abre a demo na raiz e fecha toda a API (404).
# O build falha se houver credencial real ou ARANDU_ENV junto. Vazio nos demais.
ARANDU_DEPLOYMENT_KIND=

# Site público
ARANDU_SITE_URL=
ARANDU_WRITE_TEST_URL=
# Somente para previews controlados. O build recusa este modo em VERCEL_ENV=production.
ARANDU_PRESENTATION_MODE=false
ARANDU_DISTRIBUTED_RATE_LIMIT=false
# RFC 9116: URI real (mailto: ou https:) e expiração futura. Sem ambos, retorna 404.
ARANDU_SECURITY_CONTACT=
ARANDU_SECURITY_EXPIRES=
ARANDU_ERROR_MONITORING_READY=false
ARANDU_ERROR_MONITORING_ENDPOINT=
ARANDU_ERROR_MONITORING_TOKEN=
ARANDU_BACKUP_VERIFIED_AT=

# E-mail transacional. Mantenha disabled até configurar um provedor real.
ARANDU_EMAIL_PROVIDER=disabled
ARANDU_EMAIL_FROM=
ARANDU_EMAIL_REPLY_TO=
ARANDU_TRANSACTIONAL_EMAIL_READY=false
ARANDU_EMAIL_DISPATCH_ENABLED=false
# Vercel Cron envia CRON_SECRET automaticamente no Authorization Bearer.
CRON_SECRET=
# Compatibilidade com disparador externo controlado.
ARANDU_EMAIL_CRON_SECRET=

# Public API v1 & Webhooks (docs/FINANCIAL_PUBLIC_API.md).
# Chave AES-256-GCM (32 bytes em base64) que cifra os segredos HMAC dos
# webhooks antes de irem ao banco. Sem ela, criar/entregar webhook falha fechado.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ARANDU_WEBHOOK_SECRET_KEY=
# Chave anterior, só durante a rotação (decifra; nunca cifra).
ARANDU_WEBHOOK_SECRET_KEY_PREVIOUS=
# Limite de requisições por credencial por minuto (padrão 120, entre 10 e 6000).
ARANDU_API_RATE_LIMIT_PER_MINUTE=120

# Enterprise SSO (docs/FINANCIAL_SSO.md).
# Segredo HMAC do state/PKCE do login SSO (≥ 32 caracteres aleatórios, por ambiente).
# Sem ele, "Entrar com SSO" não inicia (falha fechada).
ARANDU_SSO_STATE_SECRET=
# Broker de SSO habilitado no Supabase Auth deste ambiente: "supabase" ou vazio.
ARANDU_SSO_BROKER=
# IdP de teste (só testes locais; ignorado em produção). Nunca "true" em ambiente real.
ARANDU_SSO_MOCK_IDP=false
ARANDU_RECIPIENT_HMAC_SECRET=
ARANDU_RECIPIENT_HMAC_VERSION=v1
RESEND_API_KEY=

# Timeouts opcionais do runtime servidor, em milissegundos (1.000 a 30.000).
ARANDU_EXTERNAL_REQUEST_TIMEOUT_MS=8000
ARANDU_SUPABASE_TIMEOUT_MS=8000

# Supabase usado pela função consolidada api/[...path].js
# Obrigatório em produção. SERVICE_ROLE_KEY é segredo exclusivamente servidor.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional para aplicar migrations por CLI/psql. Nunca exponha no navegador.
SUPABASE_DB_URL=

# Execução real de staging: use somente em GitHub Environment protegido.
ARANDU_STAGING_DATABASE_URL=
ARANDU_STAGING_SITE_URL=
ARANDU_PRODUCTION_SITE_URL=
ARANDU_STAGING_PROJECT_REF=
ARANDU_PRODUCTION_PROJECT_REF=
ARANDU_STAGING_BACKUP_REFERENCE=
ARANDU_STAGING_RESTORE_REFERENCE=
ARANDU_BACKUP_PATH=

# Restore descartável. O verificador executa pg_restore; nunca aponte para staging/produção.
ARANDU_RESTORE_DATABASE_URL=
# Obrigatória apenas no fluxo de migration de produção, para comparação fail-closed.
ARANDU_PRODUCTION_DATABASE_URL=

# Administração usa Supabase Auth, papel imutável em app_metadata e MFA TOTP.
# Não existe segredo administrativo compartilhado.
